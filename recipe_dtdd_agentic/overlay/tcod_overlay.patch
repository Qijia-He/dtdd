index 689a8cc..8561c40 100644
--- a/trinity/buffer/utils.py
+++ b/trinity/buffer/utils.py
@@ -6,29 +6,51 @@ from trinity.utils.log import get_logger
 
 @contextmanager
 def retry_session(session_maker, max_retry_times: int = 2, max_retry_interval: float = 1.0):
-    """A Context manager for retrying session."""
+    """A context manager that yields a session exactly once and retries the commit.
+
+    NOTE: a @contextmanager generator MUST yield exactly once. The previous
+    implementation put the ``yield`` inside a ``for`` retry loop, so any commit
+    failure (e.g. a transient sqlite "database is locked" under Ray's concurrent
+    writes) made the generator yield a SECOND time on retry, which contextlib
+    turns into ``RuntimeError: generator didn't stop`` -- masking the real
+    (recoverable) error and crashing the explorer. Here the body runs once and
+    only the commit is retried.
+    """
     logger = get_logger(__name__)
-    for attempt in range(max_retry_times):
-        try:
-            session = session_maker()
-            yield session
-            session.commit()
-            break
-        except StopIteration as e:
-            raise e
-        except Exception as e:
-            import traceback
+    session = session_maker()
+    try:
+        yield session
+        last_exc = None
+        for attempt in range(max_retry_times):
+            try:
+                session.commit()
+                last_exc = None
+                break
+            except StopIteration:
+                raise
+            except Exception as e:  # noqa: BLE001
+                import traceback
 
-            trace_str = traceback.format_exc()
-            session.rollback()
-            logger.warning(
-                f"Attempt {attempt + 1} failed, retrying in {max_retry_interval} seconds..."
-            )
-            logger.warning(f"trace = {trace_str}")
-            if attempt < max_retry_times - 1:
-                time.sleep(max_retry_interval)
-            else:
-                logger.error("Max retry attempts reached, raising exception.")
-                raise e
-        finally:
-            session.close()
+                last_exc = e
+                logger.warning(
+                    f"Commit attempt {attempt + 1}/{max_retry_times} failed, "
+                    f"retrying in {max_retry_interval}s...\n{traceback.format_exc()}"
+                )
+                # A failed commit leaves the Session in a "pending rollback" state:
+                # SQLAlchemy refuses any further use until rollback() is called.
+                # Rolling back ONLY on the final attempt (the previous behaviour) meant
+                # attempt 2 raised PendingRollbackError instead of genuinely retrying,
+                # so a transient sqlite "database is locked" still killed the explorer
+                # (seen on both DTDD and OPD runs). Always roll back first.
+                try:
+                    session.rollback()
+                except Exception:  # noqa: BLE001
+                    pass
+                if attempt < max_retry_times - 1:
+                    # exponential backoff: lock contention needs more than a flat wait
+                    time.sleep(max_retry_interval * (2**attempt))
+        if last_exc is not None:
+            logger.error("Max retry attempts reached, raising exception.")
+            raise last_exc
+    finally:
+        session.close()
