diff --git a/trinity/common/models/vllm_model.py b/trinity/common/models/vllm_model.py
index 13d9773..28e48df 100644
--- a/trinity/common/models/vllm_model.py
+++ b/trinity/common/models/vllm_model.py
@@ -524,6 +524,52 @@ class vLLMRolloutModel(BaseInferenceModel):
                 method, timeout, args, kwargs
             )
 
+    async def _wait_adapter_complete(self, lora_dir: str, timeout: float = 300.0) -> None:
+        """Block until the adapter safetensors under ``lora_dir`` is fully written.
+
+        LoRA "sync" here is filesystem-based: the trainer WRITES
+        ``global_step_N/actor/lora_adapter`` and this engine mmap-loads it in
+        ``add_lora``. mmap turns a mid-write/truncated file into SIGBUS, which kills the
+        engine-core child outright (uncatchable) and leaves the whole job a zombie. In
+        steady state the sync handshake orders write-before-read, but on RESUME the
+        first sync races the trainer's re-save of the step-N adapter — seen
+        as a startup SIGBUS on every resume of a WebShop LoRA run across several
+        nodes (a ~240 MB adapter takes 1-2 min to land on a shared filesystem). A safetensors file self-describes
+        its full length (8-byte header size + JSON header with data offsets), so
+        completeness can be checked exactly; require it plus a stable size across one
+        poll before handing the path to vLLM.
+        """
+        import asyncio as _asyncio
+        import json as _json
+        import os as _os
+        import struct as _struct
+        import time as _time
+
+        f = _os.path.join(lora_dir, "adapter_model.safetensors")
+        deadline = _time.time() + timeout
+        last_size = -1
+        while _time.time() < deadline:
+            try:
+                size = _os.path.getsize(f)
+                if size == last_size and size > 8:
+                    with open(f, "rb") as fh:
+                        (hlen,) = _struct.unpack("<Q", fh.read(8))
+                        if 0 < hlen < size:
+                            header = _json.loads(fh.read(hlen))
+                            data_end = max(
+                                (v["data_offsets"][1] for k, v in header.items() if k != "__metadata__"),
+                                default=0,
+                            )
+                            if 8 + hlen + data_end <= size:
+                                return
+                last_size = size
+            except (OSError, ValueError, _struct.error, _json.JSONDecodeError):
+                last_size = -1  # unreadable/partial: force another stable-size round
+            await _asyncio.sleep(2)
+        self.logger.warning(
+            f"Adapter at {lora_dir} still incomplete after {timeout}s; proceeding anyway."
+        )
+
     async def sync_model(self, model_version: int, weight_source: str = "student") -> int:
         """Sync model weights to vLLM."""
         if self.enable_lora:
@@ -534,6 +580,8 @@ class vLLMRolloutModel(BaseInferenceModel):
             self.logger.info(
                 f"Redirect `lora_path` from old_model_version={self.model_version} to {model_version=} successfully."
             )
+            # Never mmap a half-written adapter (SIGBUS): wait for completeness first.
+            await self._wait_adapter_complete(self.default_lora_path)
