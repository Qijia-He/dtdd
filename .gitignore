__pycache__/
*.pyc
# Fetched by setup.sh, never committed: the thunlp/OPD base and the verl symlink
# into it. (Patterns below stay anchored to the repo root -- an unanchored
# `models/`/`checkpoint/` once matched paths inside the vendored tree and
# silently dropped 72 upstream files from a commit.)
/third_party/
/verl
/logs/
/outputs/
/wandb/
/checkpoint/
/models/
/datasets/
/results/
*.out
*.err
.jid*
*.jids
# eval artifacts
scripts/eval/justrl_eval_outputs/
# user-local autoeval config
tools/autoeval_arms.json
# Agentic lane: run state written by trinity, all regenerable, never committed.
# Root-anchored like the entries above, for the same reason.
/agent_ckpts/
/agent_buffers/
/hf_cache/
