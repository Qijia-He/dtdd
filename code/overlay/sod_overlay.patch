+        # The worked example shown to the model and the set it is graded on
+        # must not be the same object. The LiveCodeBench parquet shipped with
+        # Open-AgentRL-Eval carries exactly one test case per problem (median
+        # = mean = max = 1 across all 175) and this function printed it into
+        # the prompt AND passed it through as ground_truth, so a program that
+        # ignored the question and echoed the shown output scored 1.0. The
+        # parquets built by recipe_dtdd_code/data/build_lcb_fixed.py split
+        # them: `public_tests` is prompt-only and `reward_model` holds
+        # private-first cases for grading. Fall back to the old behaviour
+        # when the column is absent, so the original files still load and
+        # their numbers stay reproducible.
+        if row.get('public_tests'):
+            shown = json.loads(row['public_tests'])
+            inputs, outputs = shown['inputs'], shown['outputs']
+        else:
